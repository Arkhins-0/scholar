# Copy to .env.local for local development. NEVER commit real values.

# Neon pooled connection string (must include sslmode=require)
DATABASE_URL=

# openssl rand -base64 32
NEXTAUTH_SECRET=
# http://localhost:3000 locally; your production URL on Vercel (also used for links in emails)
NEXTAUTH_URL=

# ── File storage: Neon Object Storage (S3-compatible). Create a bucket and a credential
#    in the Neon console; set the bucket to PRIVATE (the app streams files itself).
AWS_ENDPOINT_URL_S3=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET=

# ── Email (Brevo transactional API). Unset EMAIL_PROVIDER = dev "log" mode (messages printed to the server log).
EMAIL_PROVIDER=brevo
BREVO_API_KEY=
EMAIL_FROM=
EMAIL_FROM_NAME=Scholar Track

# Used once by prisma/seed.ts to create the first R&D Admin (change password after first login)
RND_ADMIN_BOOTSTRAP_EMAIL=
RND_ADMIN_BOOTSTRAP_PASSWORD=
